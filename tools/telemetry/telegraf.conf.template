# Telegraf configuration template for Heimdall telemetry (REQ-TEL-3, REQ-TEL-4)
# Cross-platform process and host metrics collection for Linux and macOS

[agent]
  interval = "10s"
  round_interval = true
  metric_batch_size = 1000
  metric_buffer_limit = 10000

[global_tags]
  bridge_id = "${HEIMDALL_BRIDGE_ID}"
  bridge_host = "${HOSTNAME}"

[[inputs.http]]
  urls = ["http://127.0.0.1:${LOCAL_ENDPOINT_PORT:-49324}/api/v1/telemetry/processes"]
  data_format = "prometheus"

[[inputs.cpu]]
  percpu = false
  totalcpu = true

[[inputs.mem]]

[[outputs.prometheus_client]]
  listen = "127.0.0.1:${TELEMETRY_PORT:-9273}"
