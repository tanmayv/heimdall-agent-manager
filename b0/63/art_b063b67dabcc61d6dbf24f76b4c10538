## 4. Alternative: Unified Federated Query (PLX / Dremel)
If the ZMP Spanner database is accessible via Dremel external table mapping, the entire daily calculation can be completed in a single SQL query:

```sql
WITH ActiveMigrations AS (
  -- Query ZMP Spanner federated table
  SELECT
    project_number,
    zone_name AS target_zone,
    target_cluster_name
  FROM
    EXTERNAL_QUERY(
      'projects/spanner-connection',
      '''SELECT project_number, zone_name, target_cluster_name, flow_start_timestamp_usec, flow_finish_timestamp_usec, flow_cancel_timestamp_usec 
         FROM project_history 
         WHERE flow_cancel_timestamp_usec = 0'''
    )
  WHERE
    flow_start_timestamp_usec <= UNIX_MICROS(TIMESTAMP(:day_date)) + 86400000000
    AND (flow_finish_timestamp_usec = 0 OR flow_finish_timestamp_usec >= UNIX_MICROS(TIMESTAMP(:day_date)))
),

DefaultMap AS (
  -- Query default mapping in PLX
  SELECT DISTINCT
    cluster,
    primary_zone AS default_zone
  FROM
    `cloud_zones_all.cluster_mappings.latest`
  WHERE
    primary_zone IS NOT NULL AND primary_zone != ''
),

MastermindDaily AS (
  -- Query Mastermind daily traffic
  SELECT
    src_cloud_project_id AS src_project,
    dst_cloud_project_id AS dst_project,
    src_cluster,
    dst_cluster,
    SUM(bytes) AS physical_bytes
  FROM
    `mastermind.aggregated_cloud.all`
  WHERE
    _PARTITION_DATE = :day_date
  GROUP BY
    1, 2, 3, 4
)

SELECT
  :day_date AS date,
  m.src_project,
  m.dst_project,
  SUM(m.physical_bytes) AS overbilled_bytes,
  SUM(m.physical_bytes) / POWER(1024, 3) * 0.01 AS estimated_cost_usd
FROM
  MastermindDaily m
-- Join migrating destination projects
JOIN ActiveMigrations am ON m.dst_project = am.project_number
-- Resolve source zone
LEFT JOIN DefaultMap sz ON m.src_cluster = sz.cluster
-- Resolve destination zone
LEFT JOIN DefaultMap dz ON m.dst_cluster = dz.cluster
WHERE
  -- Rule 1: logical intra-zone
  sz.default_zone = am.target_zone
  -- Rule 2: physical inter-zone
  AND sz.default_zone != dz.default_zone
GROUP BY
  m.src_project,
  m.dst_project;
```

